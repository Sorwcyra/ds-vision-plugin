{
  "name": "ds-vision-plugin",
  "version": "0.3.0",
  "description": "Automatic Web image-to-text bridge plus vision and OCR tools for DeepSeek Harness",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": {
    "ds-vision": "dist/cli.mjs"
  },
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "dist",
    "cordis.patch.yml",
    "config.example.yml",
    "README.md",
    "README.zh-CN.md",
    "VERIFICATION.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit && npm run test",
    "test": "node --test test/*.test.mjs",
    "test:race": "node --test --test-name-pattern=\"starts all four named models concurrently\" test/router.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "deepseek-vision",
    "dsh-plugin",
    "vision",
    "vlm",
    "ocr",
    "multimodal",
    "image-to-text",
    "web-composer",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sorwcyra/ds-vision-plugin.git"
  },
  "homepage": "https://github.com/Sorwcyra/ds-vision-plugin#readme",
  "bugs": {
    "url": "https://github.com/Sorwcyra/ds-vision-plugin/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^24.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
